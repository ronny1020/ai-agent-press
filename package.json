{
  "name": "ai-agent-press",
  "version": "0.1.0",
  "description": "Transform AI agent ecosystem files into searchable documentation portals",
  "type": "module",
  "packageManager": "bun@1.3.7",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "press": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "press": "bun run src/cli/index.ts",
    "list": "bun run press list",
    "preview": "bun run press preview",
    "press:build": "bun run press build --all",
    "stub": "unbuild --stub",
    "build": "unbuild",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint-staged": "bunx lint-staged",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "bun test src/**/*.test.ts",
    "test:e2e": "PRESS_ARGS=\"--all\" playwright test --reporter=list",
    "test:all": "bun run lint && bun run type-check && bun run test && bun run test:e2e",
    "prepublishOnly": "bun run test:all && bun run build",
    "prepare": "node -e \"if ((process.env.npm_execpath || '').includes('bun')) require('child_process').spawnSync('husky', { stdio: 'inherit', shell: true })\""
  },
  "keywords": [
    "ai",
    "ai-agents",
    "documentation",
    "vitepress",
    "cli",
    "developer-tools",
    "automation"
  ],
  "author": "Ronny <1020ronny@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronny1020/ai-agent-press.git"
  },
  "homepage": "https://github.com/ronny1020/ai-agent-press#readme",
  "bugs": {
    "url": "https://github.com/ronny1020/ai-agent-press/issues"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "vitepress": "^1.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxlint": "^1.65.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "unbuild": "^3.6.1"
  }
}
