{
  "name": "ai-agent-press",
  "version": "0.1.0",
  "description": "Transform AI agent ecosystem files into searchable documentation portals",
  "type": "module",
  "packageManager": "bun@1.3.7",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "press": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "press": "bun run src/cli/index.ts",
    "list": "bun run press list",
    "preview": "bun run press preview",
    "press:build": "bun run press build --all",
    "stub": "unbuild --stub",
    "build": "unbuild",
    "lint": "oxlint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "PRESS_ARGS=\"--all\" playwright test",
    "test:all": "bun run lint && bun run type-check && bun run test && bun run test:e2e",
    "prepublishOnly": "bun run test:all && bun run build",
    "prepare": "node -e \"if ((process.env.npm_execpath || '').includes('bun')) require('child_process').spawnSync('husky', { stdio: 'inherit', shell: true })\""
  },
  "keywords": [
    "ai",
    "agents",
    "documentation",
    "vitepress",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronny1020/ai-agent-press.git"
  },
  "homepage": "https://github.com/ronny1020/ai-agent-press#readme",
  "bugs": {
    "url": "https://github.com/ronny1020/ai-agent-press/issues"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "vitepress": "^1.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "husky": "^9.1.7",
    "oxlint": "^1.65.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.6"
  }
}
